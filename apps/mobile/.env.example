# ATHR mobile environment (Expo public vars are inlined at build time).
# Copy to .env and fill in. Leaving these blank runs the app in DEMO mode.

# Supabase project (get from Supabase dashboard -> Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: override the AI engine label only; keys live server-side in edge fn secrets.
# EXPO_PUBLIC_AI_HINT=cloud
